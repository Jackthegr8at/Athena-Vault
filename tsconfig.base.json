{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "@athena/finance-engine": ["./packages/finance-engine/src/index.ts"],
      "@athena/validation": ["./packages/validation/src/index.ts"],
      "@athena/database": ["./packages/database/src/index.ts"],
      "@athena/ui": ["./packages/ui/src/index.ts"]
    },
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  }
}
