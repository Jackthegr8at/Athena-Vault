# Copy to .env.docker locally and replace placeholders before starting a stack.
# This committed file contains placeholders only; never commit the copied file.

COMPOSE_PROJECT_NAME=athena-vault

ATHENA_DB_NAME=athena_vault
ATHENA_MIGRATOR_USER=athena_migrator
ATHENA_MIGRATOR_PASSWORD=change-me-for-migrator-only
ATHENA_DB_USER=athena_app
ATHENA_DB_PASSWORD=change-me-for-local-only
ATHENA_AUTH_ROLE_PASSWORD=change-me-for-auth-role-only
# Inside Docker Compose, use the PostgreSQL service hostname `postgres`;
# localhost would point back to the web container.
DATABASE_URL=postgresql://athena_app:change-me-for-local-only@postgres:5432/athena_vault
ATHENA_AUTH_DATABASE_URL=postgresql://athena_auth:change-me-for-auth-role-only@postgres:5432/athena_vault
ATHENA_MIGRATOR_DATABASE_URL=postgresql://athena_migrator:change-me-for-migrator-only@postgres:5432/athena_vault

BETTER_AUTH_URL=https://localhost:8443
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
# Password breach screening is enabled by default. `off` is for local development only; production rejects it.
ATHENA_PASSWORD_BREACH_CHECK=enforce
ATHENA_AUTH_COOKIE_SECURE=true
# Require two-factor authentication for protected finance actions. This Docker example is production-like; keep it true.
ATHENA_AUTH_REQUIRE_2FA=true
# Optional passkey sign-in integration. Keep disabled until the local rollout gate passes.
ATHENA_PASSKEYS_ENABLED=false
# Optional EODHD token for investment symbol autocomplete. Keep it server-side.
ATHENA_EODHD_API_TOKEN=
# Optional TLS-only security notification email. In-app notifications remain enabled without these values.
ATHENA_NOTIFICATION_SMTP_HOST=
ATHENA_NOTIFICATION_SMTP_PORT=465
ATHENA_NOTIFICATION_SMTP_USER=
ATHENA_NOTIFICATION_SMTP_PASSWORD=
ATHENA_NOTIFICATION_FROM=
ATHENA_NOTIFICATION_TO=
ATHENA_AUTH_TRUSTED_ORIGINS=
ATHENA_AUTH_TRUSTED_PROXY_IPS=172.29.100.2
# /setup guard. Production-like Compose (`docker-compose.prod.yml`) requires a non-empty value.
# Local/dev Compose may leave this empty only for the immediate first run on a trusted private LAN.
ATHENA_AUTH_SETUP_TOKEN=
# Optional manual auth tools only; Docker startup does not consume these values.
# Keep them blank unless the named operator script is being run with separate secrets.
ATHENA_AUTH_BOOTSTRAP_TOKEN=
ATHENA_AUTH_BOOTSTRAP_EMAIL=
ATHENA_AUTH_BOOTSTRAP_PASSWORD=
ATHENA_AUTH_BOOTSTRAP_NAME=
ATHENA_AUTH_RECOVERY_TOKEN=
ATHENA_AUTH_RECOVERY_EMAIL=
ATHENA_AUTH_PROVISION_TOKEN=
ATHENA_AUTH_PROVISION_EMAIL=
ATHENA_AUTH_PROVISION_PASSWORD=
ATHENA_AUTH_PROVISION_NAME=
ATHENA_AUTH_INVITE_EXPIRES_HOURS=24
# Optional shared read-only demo. Provision explicitly after migrations; never seed from startup.
ATHENA_DEMO_ENABLED=false
# For a one-off provisioning run, set this to the exact ATHENA_DB_NAME being targeted.
ATHENA_DEMO_TARGET_CONFIRM=
ATHENA_DEMO_IDENTIFIER=
ATHENA_DEMO_PASSWORD=
# Empty databases are automatically schema-bootstrapped without historical data.
# Keep this legacy compatibility value false for copied-data and production helpers.
ATHENA_DOCKER_EMPTY_DATABASE=false

# Development defaults are localhost-only. Use an explicit local override for LAN testing.
ATHENA_DEV_WEB_BIND_HOST=127.0.0.1
ATHENA_DEV_WEB_HOST_PORT=3000
ATHENA_DEV_DB_PUBLISH_PORT=false
ATHENA_DEV_DB_BIND_HOST=127.0.0.1
ATHENA_DEV_DB_HOST_PORT=55432
ATHENA_WATCHPACK_POLLING=true
ATHENA_CHOKIDAR_USEPOLLING=true

# Production-like host exposure is localhost-only for the Docker Desktop proof.
# An operator must supply any non-loopback bind and matching firewall policy.
ATHENA_PROD_BIND_HOST=127.0.0.1
ATHENA_PROD_HTTP_PORT=8080
# For a direct Caddy client, BETTER_AUTH_URL and this browser-facing port
# should match ATHENA_PROD_HTTPS_PORT. If Nginx fronts Caddy, keep this at 443
# even when ATHENA_PROD_HTTPS_PORT uses a host-only internal port.
ATHENA_PROD_HTTPS_PORT=8443
ATHENA_AUTH_PUBLIC_HTTPS_PORT=8443
ATHENA_PRIVATE_HOSTNAME=localhost
# Set only for a separately reviewed private-LAN firewall workflow.
ATHENA_LAN_CIDR=
# Keep each production-like stack on a distinct Docker subnet/address when
# private and public stacks share one host. The public stack can use, for
# example, a non-overlapping RFC1918 subnet and address chosen by the operator.
ATHENA_PROD_INTERNAL_SUBNET=172.29.100.0/24
ATHENA_PROD_INTERNAL_IP_RANGE=172.29.100.128/25
ATHENA_PROD_CADDY_INTERNAL_IP=172.29.100.2

# Explicit host-mounted backup location for later manual backup/restore tasks.
ATHENA_BACKUP_HOST_PATH=/srv/athena-vault/backups
# Public age recipient used to encrypt retained backups. Keep the private identity off this host.
ATHENA_BACKUP_ENCRYPTION_RECIPIENT=
# Scheduled backup is opt-in through the fixed-time systemd timer; the private age identity
# must remain outside this host and this environment file.
ATHENA_BACKUP_RETENTION_DAYS=30
ATHENA_BACKUP_RETENTION_COUNT=14
# Required for scheduled backup: set these to the deployment user's actual numeric UID/GID.
ATHENA_BACKUP_CONTAINER_UID=
ATHENA_BACKUP_CONTAINER_GID=
ATHENA_BACKUP_IMAGE=
ATHENA_DB_TOOLS_IMAGE=
ATHENA_AGE_PACKAGE_VERSION=1.3.1-r6

# Pinned image/version contract. Do not replace these values with a floating tag.
# Before production use, set both locally built image values to the verified
# immutable IDs returned by `docker image inspect` (`sha256:<64-hex>`).
ATHENA_NODE_IMAGE=node:22.15.1-alpine3.21@sha256:d1068d8b737ffed2b8e9d0e9313177a2e2786c36780c5467ac818232e603ccd0
ATHENA_PNPM_VERSION=10.12.4
ATHENA_POSTGRES_IMAGE=postgres:18.4-alpine3.24@sha256:b6a16ed0eb96e2c362811f7eeb951eac8b459e7b40be4149ea5444aa7c65569b
ATHENA_CADDY_IMAGE=caddy:2.10.0-alpine@sha256:f43d8810c944e27e6f7ea80b165de11dbdab16cff15c8a80d83ae3e1a109a35d

# Development and production-like data/state must never share volume names.
ATHENA_DEV_POSTGRES_VOLUME_NAME=athena-vault-dev-postgres
ATHENA_DEV_BACKUP_VOLUME_NAME=athena-vault-dev-backups
ATHENA_PROD_POSTGRES_VOLUME_NAME=athena-vault-prod-postgres
ATHENA_PROD_BACKUP_VOLUME_NAME=athena-vault-prod-backups
