DATABASE_URL=postgresql://athena_app:change-me@localhost:5432/athena_vault
# Auth runtime role for Better Auth tables. Production Compose requires both.
ATHENA_AUTH_ROLE_PASSWORD=change-me-for-auth-role-only
# For native local development, use localhost. Docker Compose must use the
# PostgreSQL service hostname `postgres` instead of localhost.
ATHENA_AUTH_DATABASE_URL=postgresql://athena_auth:$ATHENA_AUTH_ROLE_PASSWORD@localhost:5432/athena_vault
# Required for migrations after PostgreSQL RLS is enabled.
ATHENA_MIGRATOR_PASSWORD=change-me-for-migrator-only
ATHENA_MIGRATOR_DATABASE_URL=postgresql://athena_migrator:$ATHENA_MIGRATOR_PASSWORD@localhost:5432/athena_vault
# Local bootstrap requires an existing PostgreSQL superuser to provision the athena_app and athena_migrator roles.
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=change-me-for-admin-only
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
# Local-only: HTTP origin for native development; production must use an HTTPS origin.
BETTER_AUTH_URL=http://localhost:3000
# Password breach screening is enabled by default. `off` is for local development only; production rejects it.
ATHENA_PASSWORD_BREACH_CHECK=enforce
NEXT_PUBLIC_APP_NAME=Athena Vault
# Local-only: insecure cookie flag for native development; production must be `true`.
ATHENA_AUTH_COOKIE_SECURE=false
# Require two-factor authentication for protected finance actions. Local-only: false; production must be `true` or `false`.
ATHENA_AUTH_REQUIRE_2FA=false
# Optional passkey sign-in integration. Keep disabled until the local rollout gate passes.
ATHENA_PASSKEYS_ENABLED=false
# Optional EODHD token for investment symbol autocomplete. Keep it server-side.
ATHENA_EODHD_API_TOKEN=
# Optional TLS-only security notification email. In-app notifications remain enabled without these values.
ATHENA_NOTIFICATION_SMTP_HOST=
ATHENA_NOTIFICATION_SMTP_PORT=465
ATHENA_NOTIFICATION_SMTP_USER=
ATHENA_NOTIFICATION_SMTP_PASSWORD=
ATHENA_NOTIFICATION_FROM=
ATHENA_NOTIFICATION_TO=
ATHENA_AUTH_TRUSTED_ORIGINS=
# Local-only: leave blank for native Next development; production must use the explicit Caddy proxy IP.
ATHENA_AUTH_TRUSTED_PROXY_IPS=
# Optional. When set, /setup requires this value; when empty, setup is tokenless.
ATHENA_AUTH_SETUP_TOKEN=
ATHENA_AUTH_BOOTSTRAP_TOKEN=replace-with-a-long-random-token
ATHENA_AUTH_BOOTSTRAP_EMAIL=owner@example.com
ATHENA_AUTH_BOOTSTRAP_PASSWORD=change-me
ATHENA_AUTH_BOOTSTRAP_NAME=
ATHENA_AUTH_RECOVERY_TOKEN=replace-with-a-long-random-token
ATHENA_AUTH_RECOVERY_EMAIL=owner@example.com
ATHENA_AUTH_PROVISION_TOKEN=replace-with-a-long-random-token
ATHENA_AUTH_PROVISION_EMAIL=owner@example.com
ATHENA_AUTH_PROVISION_PASSWORD=change-me
ATHENA_AUTH_PROVISION_NAME=
ATHENA_AUTH_INVITE_EXPIRES_HOURS=24
# Optional shared read-only demo. Keep disabled and blank in committed examples.
ATHENA_DEMO_ENABLED=false
ATHENA_DEMO_IDENTIFIER=
ATHENA_DEMO_PASSWORD=
# Optional local tool paths belong in the ignored .env.local when needed.
# Private remote-backup restore settings are intentionally not published as examples.
